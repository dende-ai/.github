{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENT_PROTOCOL.md", "CODE_STYLE.md"],
  "permission": {
    "bash": {
      "*gh *release *create*": "ask",
      "git push *--tags*": "ask",
      "git push *--follow-tags*": "ask",
      "git push *refs/tags/*": "ask",
      "git push * v*.*.*": "ask",
      "*gh *workflow *run*": "ask",
      "*gh *run *rerun*": "ask",
      "*gh *api *dispatches*": "ask",
      "*terraform *apply*": "deny",
      "*terraform *destroy*": "deny",
      "*cicd/apply.sh*": "deny",
      "*aws * create-*": "deny",
      "*aws * update-*": "deny",
      "*aws * delete-*": "deny",
      "*aws * put-*": "deny",
      "*aws * modify-*": "deny",
      "*aws * set-*": "deny",
      "*aws * add-*": "deny",
      "*aws * remove-*": "deny",
      "*aws * attach-*": "deny",
      "*aws * detach-*": "deny",
      "*aws * associate-*": "deny",
      "*aws * disassociate-*": "deny",
      "*aws * enable-*": "deny",
      "*aws * disable-*": "deny",
      "*aws * register-*": "deny",
      "*aws * deregister-*": "deny",
      "*aws * start-*": "deny",
      "*aws * stop-*": "deny",
      "*aws * run-*": "deny",
      "*aws * reboot-*": "deny",
      "*aws * terminate-*": "deny",
      "*aws * restore-*": "deny",
      "*aws * rotate-*": "deny",
      "*aws * invoke*": "deny",
      "*aws * execute-*": "deny",
      "*aws * deploy*": "deny",
      "*aws * send-*": "deny",
      "*aws * publish*": "deny",
      "*aws * purge-*": "deny",
      "*aws * batch-*": "deny",
      "*aws * copy-*": "deny",
      "*aws * authorize-*": "deny",
      "*aws * revoke-*": "deny",
      "*aws * tag-*": "deny",
      "*aws *s3 cp*": "deny",
      "*aws *s3 mv*": "deny",
      "*aws *s3 rm*": "deny",
      "*aws *s3 sync*": "deny",
      "*aws *s3 mb*": "deny",
      "*aws *s3 rb*": "deny",
      "git push": "deny",
      "git push origin": "deny",
      "git push -u origin": "deny",
      "git push --set-upstream origin": "deny",
      "git push * HEAD": "deny",
      "git push * HEAD *": "deny",
      "git push * @": "deny",
      "git push * @ *": "deny",
      "git push * main": "deny",
      "git push * main *": "deny",
      "git push *:main": "deny",
      "git push *:main *": "deny",
      "git push *:refs/heads/main": "deny",
      "git push *:refs/heads/main *": "deny",
      "git push * refs/heads/main": "deny",
      "git push * refs/heads/main *": "deny",
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git push -f *": "deny",
      "git push * -f": "deny",
      "git push * -f *": "deny",
      "git push * +*": "deny",
      "git push --all*": "deny",
      "git push * --all*": "deny",
      "git push --mirror*": "deny",
      "git push * --mirror*": "deny",
      "git * --no-verify*": "deny"
    },
    "edit": {
      "*AGENT_PROTOCOL.md": "deny",
      "*CODE_STYLE.md": "deny",
      "*CLAUDE.md": "deny",
      "*opencode.json": "deny",
      "*.claude/settings.json": "deny",
      "*/skills/dende-*": "deny"
    },
    "read": {
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    }
  }
}
